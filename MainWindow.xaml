<!-- MainWindow.xaml -->
<Window x:Class="BluetoothFileTransfer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Bluetooth Transfer" Height="500" Width="800"
        Icon="Assets/AppIcon.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource MaterialDesignPaper}"
        TextElement.Foreground="{DynamicResource MaterialDesignBody}"
        Loaded="Window_Loaded">

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- 左カラム：デバイスリストと検索 -->
        <materialDesign:Card Grid.Column="0" Margin="8" Padding="16" UniformCornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Button x:Name="SearchButton" Content="デバイスを検索" Click="SearchButton_Click" Margin="0,0,0,16" />

                <ListBox x:Name="DeviceListBox" Grid.Row="1" DisplayMemberPath="DeviceName" />
            </Grid>
        </materialDesign:Card>

        <!-- 右カラム：ドラッグ＆ドロップエリア、進捗、ログ -->
        <Grid Grid.Column="1" Margin="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <!-- プログレスバー用に追加 -->
                <RowDefinition Height="150" />
            </Grid.RowDefinitions>

            <!-- ドラッグ＆ドロップエリア -->
            <materialDesign:Card Grid.Row="0" Margin="0,0,0,16" UniformCornerRadius="8" Background="#1E1E1E"
                                 AllowDrop="True" Drop="FileDropArea_Drop" DragEnter="FileDropArea_DragEnter">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                    <materialDesign:PackIcon Kind="CloudUpload" Width="64" Height="64" HorizontalAlignment="Center" Foreground="#2196F3"/>
                    <TextBlock Text="ここにファイルをドラッグ＆ドロップして送信&#10;(.csv, .json, .pdf, .xlsx, .md など)" 
                               TextAlignment="Center" FontSize="14" Margin="0,16,0,0" Foreground="LightGray"/>
                </StackPanel>
            </materialDesign:Card>

            <!-- 進捗バー (追加) -->
            <ProgressBar x:Name="TransferProgressBar" Grid.Row="1" Minimum="0" Maximum="100" Value="0" 
                         Height="8" Margin="0,0,0,16" Foreground="#2196F3" Background="#333333" />

            <!-- ログ表示エリア -->
            <materialDesign:Card Grid.Row="2" UniformCornerRadius="8" Padding="8">
                <ScrollViewer x:Name="LogScrollViewer">
                    <TextBlock x:Name="LogTextBlock" TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>
            </materialDesign:Card>
        </Grid>
    </Grid>
</Window>